# Arellano University LMS (AU-JAS) Environment Configuration
# Copy this file to .env.dev or .env.prd and configure the public client keys.

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser client bundle)
# NOTE: NEVER put SUPABASE_SERVICE_ROLE_KEY here or in any VITE_* variable.
VITE_SUPABASE_ANON_KEY=your-anon-public-jwt-key

